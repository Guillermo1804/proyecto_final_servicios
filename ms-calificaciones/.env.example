# =============================================
# MS-4: Calificaciones — Variables de Entorno (Fase 6)
# =============================================
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
SERVICE_NAME=ms-calificaciones
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

DB_HOST=db-calificaciones
DB_PORT=3306
DB_NAME=agm_calificaciones_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4

REST_PORT=8004
GRPC_PORT=50054

# Fase 6 — bus de eventos
USE_EVENT_BUS=true
EVENT_QUEUE_NAME=ms-calificaciones.events
EVENT_CONTRACTS_DIR=/contracts/events

JWT_JWKS_URL=http://ms-auth:8001/.well-known/jwks.json
JWT_JWKS_CACHE_TTL_SECONDS=300

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agm_bus
RABBITMQ_PASSWORD=agm_bus_dev_change_me
RABBITMQ_VHOST=agm
RABBITMQ_EXCHANGE=agm.domain

# Backfill opcional (snapshot desde MS-2 / MS-3 en dev)
BACKFILL_PERIODOS_DB_HOST=db-periodos
BACKFILL_PERIODOS_DB_PORT=3306
BACKFILL_PERIODOS_DB_NAME=agm_periodos_db
BACKFILL_PERIODOS_DB_USER=root
BACKFILL_PERIODOS_DB_PASSWORD=root_password

BACKFILL_ALUMNOS_DB_HOST=db-alumnos
BACKFILL_ALUMNOS_DB_PORT=3306
BACKFILL_ALUMNOS_DB_NAME=agm_alumnos_db
BACKFILL_ALUMNOS_DB_USER=root
BACKFILL_ALUMNOS_DB_PASSWORD=root_password

# gRPC legacy (USE_EVENT_BUS=false)
MS_AUTH_GRPC_HOST=ms-auth
MS_AUTH_GRPC_PORT=50051
MS_PERIODOS_GRPC_HOST=ms-periodos
MS_PERIODOS_GRPC_PORT=50052
MS_ALUMNOS_GRPC_HOST=ms-alumnos
MS_ALUMNOS_GRPC_PORT=50053
MS_NOTIFICACIONES_GRPC_HOST=ms-notificaciones
MS_NOTIFICACIONES_GRPC_PORT=50056
GRPC_CLIENT_TIMEOUT=5
