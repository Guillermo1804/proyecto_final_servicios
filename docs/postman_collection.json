{
  "info": {
    "name": "AGM API Gateway (local)",
    "description": "Colección mínima Epic 1 — base http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "internalApiKey", "value": "cambiar-clave-interna-segura" }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j.data && j.data.access_token) pm.collectionVariables.set('accessToken', j.data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@agm.buap.mx\",\"password\":\"admin123\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Periodos activo",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/periodos/activo/"
      }
    },
    {
      "name": "Docentes list",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/docentes/"
      }
    },
    {
      "name": "MS-6 Bienvenida",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Internal-Api-Key", "value": "{{internalApiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"alumno_id\":1,\"materia_id\":10,\"clave_acceso\":\"clave-demo\"}"
        },
        "url": "{{baseUrl}}/notificaciones/bienvenida"
      }
    },
    {
      "name": "MS-6 Reset password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Internal-Api-Key", "value": "{{internalApiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"user@buap.mx\",\"token\":\"abc\",\"reset_url\":\"http://localhost:4200/reset-password?token=abc\"}"
        },
        "url": "{{baseUrl}}/notificaciones/reset-password"
      }
    }
  ]
}
