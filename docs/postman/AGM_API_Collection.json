						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url_gateway}}/reportes/asistencias/{{materia_id}}?formato=pdf",
