{
	"info": {
		"_postman_id": "18f9e0a0-0000-4000-8000-000000000001",
		"name": "AGM API Collection",
		"description": "Colección de APIs para el proyecto AGM (Periodos y Alumnos)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "MS-1 Auth",
			"description": "MS-1 Auth & Users (:8001 o gateway :8080). Tras Login, copiar access_token a {{jwt_token}}.",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"const d = body.data || {};",
									"if (d.access_token) pm.environment.set('jwt_token', d.access_token);",
									"if (d.refresh_token) pm.environment.set('refresh_token', d.refresh_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@agm.buap.mx\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url_gateway}}/auth/login",
							"host": ["{{base_url_gateway}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Refresh token",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url_gateway}}/auth/refresh-token",
							"host": ["{{base_url_gateway}}"],
							"path": ["auth", "refresh-token"]
						}
					}
				},
				{
					"name": "Me (perfil)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": {
							"raw": "{{base_url_gateway}}/auth/me",
							"host": ["{{base_url_gateway}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url_gateway}}/auth/logout",
							"host": ["{{base_url_gateway}}"],
							"path": ["auth", "logout"]
						}
					}
				},
				{
					"name": "Forgot password",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"usuario@buap.mx\"\n}"
						},
						"url": {
							"raw": "{{base_url_gateway}}/auth/forgot-password",
							"host": ["{{base_url_gateway}}"],
							"path": ["auth", "forgot-password"]
						}
					}
				},
				{
					"name": "Listar usuarios (admin)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": {
							"raw": "{{base_url_gateway}}/usuarios?page=1&limit=10",
							"host": ["{{base_url_gateway}}"],
							"path": ["usuarios"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Crear usuario (API key MS-3)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Internal-Api-Key", "value": "{{internal_api_key}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"nuevo.alumno@buap.mx\",\n    \"nombre\": \"Alumno Nuevo\",\n    \"rol\": \"alumno\",\n    \"password\": \"ClaveTemporal123!\",\n    \"send_email\": false\n}"
						},
						"url": {
							"raw": "{{base_url_gateway}}/usuarios",
							"host": ["{{base_url_gateway}}"],
							"path": ["usuarios"]
						}
					}
				}
			]
		},
