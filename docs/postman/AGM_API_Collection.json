		{
			"name": "MS-7 Reportes y Estadísticas",
			"description": "REST vía gateway (:8080) o directo (:8007). Requiere **Authorization: Bearer {{jwt_token}}** (MS-1). `internal_api_key` no aplica a MS-7 (solo MS-6). IDs: `materia_id` = PK MS-2; `docente_usuario_id` = usuario_id MS-1; `alumno_id` = PK Alumno MS-3.",
			"item": [
				{
					"name": "Calificaciones — Excel (xlsx)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": {
							"raw": "{{base_url_gateway}}/reportes/calificaciones/{{materia_id}}?formato=xlsx",
							"host": ["{{base_url_gateway}}"],
							"path": ["reportes", "calificaciones", "{{materia_id}}"],
							"query": [{ "key": "formato", "value": "xlsx" }]
						},
						"description": "Descarga binaria Excel del concentrado de calificaciones (ISSUE-902). Alias: formato=xls."
					}
				},
