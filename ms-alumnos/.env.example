# =============================================
# MS-3: Docentes & Alumnos — Variables de Entorno
# =============================================
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
SERVICE_NAME=ms-alumnos
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

DB_HOST=db-alumnos
DB_PORT=3306
DB_NAME=agm_alumnos_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4

REST_PORT=8003
GRPC_PORT=50053

# Alta de usuarios en MS-1 (USE_EVENT_BUS=true → HTTP, no gRPC)
MS_AUTH_HTTP_URL=http://ms-auth:8001
MS_AUTH_HTTP_TIMEOUT=10
INTERNAL_API_KEY=cambiar-en-produccion

# gRPC hacia otros MS (legacy si USE_EVENT_BUS=false)
MS_AUTH_GRPC_HOST=ms-auth
MS_AUTH_GRPC_PORT=50051
MS_PERIODOS_GRPC_HOST=ms-periodos
MS_PERIODOS_GRPC_PORT=50052
MS_NOTIFICACIONES_GRPC_HOST=ms-notificaciones
MS_NOTIFICACIONES_GRPC_PORT=50056
GRPC_CLIENT_TIMEOUT=5

# Fase 4 — JWT local + bus de eventos
USE_EVENT_BUS=true
JWT_JWKS_URL=http://ms-auth:8001/.well-known/jwks.json
JWT_JWKS_CACHE_TTL_SECONDS=300
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agm_bus
RABBITMQ_PASSWORD=agm_bus_dev_change_me
RABBITMQ_VHOST=agm
EVENT_EXCHANGE=agm.domain
EVENT_PUBLISH_RETRIES=5
EVENT_PUBLISH_BACKOFF_SECONDS=2
EVENT_CONTRACTS_DIR=/contracts/events
EVENT_QUEUE_NAME=ms-alumnos.events

# DEMO: True permite importar alumnos aunque el NRC del PDF no coincida.
# En producción real debe ser False.
ALLOW_NRC_MISMATCH_DEMO=true
