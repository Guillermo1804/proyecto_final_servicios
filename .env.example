# =============================================
# AGM — Variables globales (raíz del monorepo)
# Copiar a .env para docker compose y smoke tests locales.
# Fase 1 — Bus de eventos (RabbitMQ)
# =============================================

# --- RabbitMQ (servicio docker: rabbitmq) ---
# Desde el host (smoke_test): localhost
# Desde contenedores MS: rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=agm_bus
RABBITMQ_PASSWORD=agm_bus_dev_change_me
RABBITMQ_VHOST=agm

# Exchange y convenciones
EVENT_EXCHANGE=agm.domain
EVENT_PUBLISH_RETRIES=5
EVENT_PUBLISH_BACKOFF_SECONDS=2
EVENT_CONSUME_MAX_RETRIES=5
EVENT_CONSUME_PREFETCH=10

# Feature flag global (Fase 2+ por microservicio)
USE_EVENT_BUS=true

# Dominio publico servido por Caddy (docker-compose.yml unico) y correo opcional Let's Encrypt.
AGM_DOMAIN=agm.aurelyte.iokoia.com
ACME_EMAIL=

# Cola de humo Fase 1 (no usar en producción de MS)
SMOKE_TEST_QUEUE=ms-smoke-test.events
SMOKE_TEST_ROUTING_KEY=health.ping.v1
