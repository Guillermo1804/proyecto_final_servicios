# =============================================
# MS-1: Auth & Users — Variables de Entorno
# =============================================
# Copiar este archivo como .env y completar los valores

# Django
SECRET_KEY=cambiar-en-produccion-usar-clave-segura
DEBUG=True
ALLOWED_HOSTS=*

# Base de datos MySQL
DB_HOST=db-auth
DB_PORT=3306
DB_NAME=agm_auth_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4

# Puertos del servicio
REST_PORT=8001
GRPC_PORT=50051

# JWT — Tiempos de vida de tokens (ISSUE-302)
# - ACCESS_TOKEN_LIFETIME: duración del token de acceso (recomendado: 15-60 minutos)
# - REFRESH_TOKEN_LIFETIME: duración del token de refresco (recomendado: 7 días)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# gRPC hacia otros MS
MS_NOTIFICACIONES_GRPC_HOST=ms-notificaciones
MS_NOTIFICACIONES_GRPC_PORT=50056

# URLs frontales (para reset password en ISSUE-303)
FRONTEND_URL=http://localhost:4200

# Clave interna para alta de usuarios (ISSUE-307)
INTERNAL_API_KEY=cambiar-en-produccion

# Admin por defecto (se crea en el primer arranque — ISSUE-301)
ADMIN_EMAIL=admin@agm.buap.mx
ADMIN_PASSWORD=admin123
