# =============================================
# MS-1: Auth & Users — Variables de Entorno
# =============================================
# Copiar este archivo como .env y completar los valores

# Django
SECRET_KEY=cambiar-en-produccion-usar-clave-segura
DEBUG=True
ALLOWED_HOSTS=*
SERVICE_NAME=ms-auth

# CORS (desarrollo: True; producción: False + lista de orígenes)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

# Base de datos MySQL
DB_HOST=db-auth
DB_PORT=3306
DB_NAME=agm_auth_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4

# Puertos del servicio
REST_PORT=8001
GRPC_PORT=50051

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# gRPC hacia otros MS
MS_NOTIFICACIONES_GRPC_HOST=ms-notificaciones
MS_NOTIFICACIONES_GRPC_PORT=50056
GRPC_CLIENT_TIMEOUT=5

# Admin por defecto (se crea en el primer arranque)
ADMIN_EMAIL=admin@agm.buap.mx
ADMIN_PASSWORD=admin123
