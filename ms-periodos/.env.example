# =============================================
# MS-2: Periodos & Materias — Variables de Entorno
# =============================================
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
SERVICE_NAME=ms-periodos
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080

DB_HOST=db-periodos
DB_PORT=3306
DB_NAME=agm_periodos_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4

REST_PORT=8002
GRPC_PORT=50052

# gRPC hacia otros MS
MS_AUTH_GRPC_HOST=ms-auth
MS_AUTH_GRPC_PORT=50051
MS_ALUMNOS_GRPC_HOST=ms-alumnos
MS_ALUMNOS_GRPC_PORT=50053

# Fase 3 — JWT local + bus de eventos
USE_EVENT_BUS=true
JWT_JWKS_URL=http://ms-auth:8001/.well-known/jwks.json
JWT_JWKS_CACHE_TTL_SECONDS=300
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agm_bus
RABBITMQ_PASSWORD=agm_bus_dev_change_me
RABBITMQ_VHOST=agm
EVENT_EXCHANGE=agm.domain
EVENT_PUBLISH_RETRIES=5
EVENT_PUBLISH_BACKOFF_SECONDS=2
EVENT_QUEUE_NAME=ms-periodos.events
EVENT_CONTRACTS_DIR=/contracts/events
