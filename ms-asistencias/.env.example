# =============================================
# MS-5: Asistencias QR — Variables de Entorno (Fase 7)
# =============================================
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=*
SERVICE_NAME=ms-asistencias
CORS_ALLOW_ALL_ORIGINS=True

DB_HOST=db-asistencias
DB_PORT=3306
DB_NAME=agm_asistencias_db
DB_USER=root
DB_PASSWORD=root_password

REST_PORT=8005
GRPC_PORT=50055

REDIS_HOST=redis
REDIS_PORT=6379
QR_HMAC_SECRET=clave-secreta-para-hmac-cambiar-en-produccion

USE_EVENT_BUS=true
EVENT_QUEUE_NAME=ms-asistencias.events
EVENT_CONTRACTS_DIR=/contracts/events

JWT_JWKS_URL=http://ms-auth:8001/.well-known/jwks.json
JWT_JWKS_CACHE_TTL_SECONDS=300

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agm_bus
RABBITMQ_PASSWORD=agm_bus_dev_change_me
RABBITMQ_VHOST=agm
RABBITMQ_EXCHANGE=agm.domain

BACKFILL_PERIODOS_DB_HOST=db-periodos
BACKFILL_PERIODOS_DB_PORT=3306
BACKFILL_PERIODOS_DB_NAME=agm_periodos_db
BACKFILL_PERIODOS_DB_USER=root
BACKFILL_PERIODOS_DB_PASSWORD=root_password

BACKFILL_ALUMNOS_DB_HOST=db-alumnos
BACKFILL_ALUMNOS_DB_PORT=3306
BACKFILL_ALUMNOS_DB_NAME=agm_alumnos_db
BACKFILL_ALUMNOS_DB_USER=root
